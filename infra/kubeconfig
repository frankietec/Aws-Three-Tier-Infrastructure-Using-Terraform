apiVersion: v1
kind: Config

clusters:
- name: eks
  cluster:
    server: https://BC59B8771D5B23C548B5B91AE0EECBD1.gr7.us-east-1.eks.amazonaws.com
    certificate-authority-data: 

contexts:
- name: eks
  context:
    cluster: eks
    user: eks

current-context: eks

users:
- name: eks
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      args:
        - eks
        - get-token
        - --cluster-name
        - portal-app-dev-cluster
        - --region
        - us-east-1
